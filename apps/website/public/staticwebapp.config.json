{
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' https://fonts.gstatic.com data:; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: https:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; upgrade-insecure-requests",
    "Permissions-Policy": "camera=(), geolocation=(), microphone=(), payment=(), usb=()",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/assets/*",
      "/brand/*",
      "/images/*",
      "/*.{css,cur,gif,ico,jpeg,jpg,js,json,map,png,svg,txt,webmanifest,webp,woff,woff2,xml}"
    ]
  },
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": [
        "anonymous"
      ],
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/",
      "rewrite": "/index.html"
    },
    {
      "route": "/products",
      "rewrite": "/products/index.html"
    },
    {
      "route": "/products/business-software",
      "rewrite": "/products/business-software/index.html"
    },
    {
      "route": "/products/desktop-apps",
      "rewrite": "/products/desktop-apps/index.html"
    },
    {
      "route": "/products/pulse",
      "rewrite": "/products/pulse/index.html"
    },
    {
      "route": "/products/pr-pulse-pro",
      "rewrite": "/products/pr-pulse-pro/index.html"
    },
    {
      "route": "/products/treefold",
      "rewrite": "/products/treefold/index.html"
    },
    {
      "route": "/products/tagfold",
      "rewrite": "/products/tagfold/index.html"
    },
    {
      "route": "/products/company-verify",
      "rewrite": "/products/company-verify/index.html"
    },
    {
      "route": "/pricing",
      "rewrite": "/pricing/index.html"
    },
    {
      "route": "/contact",
      "rewrite": "/contact/index.html"
    },
    {
      "route": "/pilots",
      "rewrite": "/pilots/index.html"
    },
    {
      "route": "/about",
      "rewrite": "/about/index.html"
    },
    {
